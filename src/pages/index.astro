---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import TechArsenal from '../components/TechArsenal';
import SecurityTile from '../components/SecurityTile';
import ClubCommunity from '../components/ClubCommunity';
import LocationCard from '../components/LocationCard';
import ProjectsGrid from '../components/ProjectsGrid';
import Timeline from '../components/Timeline';
import Contact from '../components/Contact';
---

<BaseLayout>
  <!-- Navbar -->
  <Navbar client:load />

  <!-- Hero / About -->
  <Hero client:load />

  <!-- ── Broken Grid Info Section ── -->
  <div class="mx-auto max-w-7xl px-4 py-16 sm:py-24 sm:px-6 lg:px-12">
    <div class="relative grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-8 items-start">
      
      <!-- Left: Security (Span 7) -->
      <div class="md:col-span-7 md:mt-16 z-10">
        <SecurityTile client:visible />
      </div>

      <!-- Right: Club & Learning (Span 5) -->
      <div class="md:col-span-5 flex flex-col gap-8">
        <ClubCommunity client:visible />
        
        <!-- Solid Clean Quick stat -->
        <div class="solid-card hover-red-border p-8 flex items-start gap-5 group">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center border border-[var(--color-border-subtle)] bg-transparent text-[var(--color-accent)] font-mono text-lg transition-all group-hover:bg-[var(--color-accent)] group-hover:text-white">
            ///
          </div>
          <div>
            <p class="text-base font-display uppercase tracking-[0.2em] text-white">Evolving</p>
            <p class="font-mono text-xs text-[var(--color-text-secondary)] mt-2 uppercase tracking-wider group-hover:text-[var(--color-accent)] transition-colors duration-300">
              Exploring Rust & Cloud Sec.
            </p>
          </div>
        </div>

        <div class="md:-ml-12 lg:-ml-24 xl:-ml-32 w-full md:w-[120%] z-20 mt-4 md:mt-8">
          <LocationCard client:visible />
        </div>
      </div>
    </div>
  </div>

  <!-- Tech Arsenal -->
  <div class="w-full bg-[var(--color-bg-card)] border-y border-[var(--color-border-subtle)] py-20 my-10">
    <TechArsenal client:visible />
  </div>

  <!-- Projects Grid -->
  <ProjectsGrid client:visible />

  <!-- Journey Timeline -->
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-12 my-10 relative">
    <div class="absolute left-0 top-1/2 w-8 h-[2px] bg-[var(--color-accent)]"></div>
    <Timeline client:visible />
  </div>

  <!-- Contact -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-12 w-full">
    <Contact client:visible />
  </div>
</BaseLayout>
